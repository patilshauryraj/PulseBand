# Database (Default: SQLite for instant local zero-setup; or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./pulseband.db
# DATABASE_URL=postgresql+asyncpg://pulseuser:pulsepassword123@localhost:5432/pulseband_db

# Security
JWT_SECRET=pulseband_super_secret_jwt_key_development_only_2026
JWT_REFRESH_SECRET=pulseband_super_secret_refresh_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
